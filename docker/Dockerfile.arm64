# syntax=docker/dockerfile:1.6

# -------------------------
# Stage 1: base -- apt deps shared by builder + final stages
# -------------------------
FROM ubuntu:jammy AS base

ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies
RUN apt-get update && \
  apt-get install -y sudo && \
  apt-get install -y wget git curl apt-transport-https && \
  apt-get install -y bash-completion tree vim && \
  apt-get install -y build-essential make cmake ninja-build && \
  apt-get install -y clang-14 gcc g++ && \
  apt-get install -y zlib1g-dev libabsl-dev lsb-release && \
  apt-get install -y graphviz && \
  apt-get clean -y && \
  rm -rf /var/lib/apt/lists/*

# -------------------------
# Stage 2: ortools -- build OR-Tools from source (no official arm64 ubuntu prebuilt)
#   All build-time clutter (source tree, vendored Abseil/protobuf builds) lives in this
#   stage and is discarded; only /opt/ortools is copied into the final image.
# -------------------------
FROM base AS ortools

ENV ORTOOLS_DIR=/opt/ortools
ENV ORTOOLS_VERSION=v9.12
RUN apt-get update && \
  apt-get install -y pkg-config && \
  rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${ORTOOLS_VERSION} https://github.com/google/or-tools.git /tmp/or-tools && \
  cmake -S /tmp/or-tools -B /tmp/or-tools/build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=$ORTOOLS_DIR \
    -DBUILD_DEPS=ON \
    -DBUILD_SAMPLES=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_PYTHON=OFF \
    -DBUILD_FLATZINC=OFF \
    -DBUILD_TESTING=OFF && \
  cmake --build /tmp/or-tools/build -j$(nproc) && \
  cmake --install /tmp/or-tools/build && \
  rm -rf /tmp/or-tools

# -------------------------
# Stage 3: final -- runtime image
# -------------------------
FROM base AS final

# Install Miniconda
ENV MINICONDA_DIR=/opt/miniconda
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh -O /opt/miniconda.sh && \
  chmod +x /opt/miniconda.sh && \
  /opt/miniconda.sh -b -p $MINICONDA_DIR && \
  rm -rf /opt/miniconda.sh && \
  $MINICONDA_DIR/bin/conda tos accept && \
  $MINICONDA_DIR/bin/conda init bash && \
  $MINICONDA_DIR/bin/conda config --set auto_activate_base false

# Create conda env using requirements.yml
COPY requirements.yml /requirements.yml
RUN . $MINICONDA_DIR/etc/profile.d/conda.sh && \
  conda env create --file /requirements.yml && \
  conda clean -y --all && \
  echo "conda list --name act >/dev/null 2>&1 && conda activate act" >> ~/.bashrc

# Install Rust (rustup)
ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path && \
  /opt/cargo/bin/rustup default stable && \
  chmod -R a+rx /opt/cargo /opt/rustup && \
  echo 'export PATH="/opt/cargo/bin:$PATH"' >> ~/.bashrc

# Pull OR-Tools from the ortools builder stage
ENV ORTOOLS_DIR=/opt/ortools
COPY --from=ortools /opt/ortools /opt/ortools
RUN echo "export LD_LIBRARY_PATH=$ORTOOLS_DIR/lib:$LD_LIBRARY_PATH" >> ~/.bashrc && \
  echo "export ORTOOLS_DIR=$ORTOOLS_DIR" >> ~/.bashrc

# Install nlohmann/json (for C++ backend)
ENV NLOHMANN_JSON_DIR=/opt/nlohmann_json
RUN wget -q https://github.com/nlohmann/json/releases/download/v3.12.0/json.tar.xz -O /tmp/json.tar.xz && \
  mkdir -p $NLOHMANN_JSON_DIR && \
  tar -xf /tmp/json.tar.xz -C $NLOHMANN_JSON_DIR --strip-components=1 && \
  rm -rf /tmp/json.tar.xz && \
  echo "export NLOHMANN_JSON_DIR=$NLOHMANN_JSON_DIR" >> ~/.bashrc

# Install act-ecosystem package
COPY pyproject.toml /opt/act/pyproject.toml
COPY act/ /opt/act/act/
COPY README.md /opt/act/README.md
COPY LICENSE /opt/act/LICENSE
RUN . $MINICONDA_DIR/etc/profile.d/conda.sh && conda activate act && \
  pip install --no-cache-dir /opt/act && \
  rm -rf /opt/act

RUN echo "umask 0002" >> ~/.bashrc

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
