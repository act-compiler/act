HloModule k2_AB_C, entry_computation_layout={(s8[16,16], s8[16,16], s8[16,16])->s8[16,16]}

ENTRY main {
  A = s8[16,16] parameter(0)
  B = s8[16,16] parameter(1)
  C = s8[16,16] parameter(2)
  AB = s8[16,16] dot(A, B), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  ROOT AB_C = s8[16,16] add(AB, C)
}
