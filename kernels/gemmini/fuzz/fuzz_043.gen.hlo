  dot_16 = s8[16,16] dot(dot_23, broadcast_15), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  subtract_12 = s8[16,16] subtract(dot_16, minimum_14)
  dot_10 = s8[16,16] dot(broadcast_3, subtract_12), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  dot_22 = s8[16,16] dot(dot_10, broadcast_15), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  negate_31 = s8[16,16] negate(broadcast_11)
  maximum_7 = s8[16,16] maximum(broadcast_3, negate_31)
  reverse_32 = s8[16,16] reverse(reverse_17), dimensions={0,1}
  constant_33 = s8[] constant(16)
