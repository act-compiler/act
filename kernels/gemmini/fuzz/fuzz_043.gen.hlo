  maximum_35 = s8[16,16] maximum(broadcast_33, broadcast_34)
  add_19 = s8[16,16] add(maximum_35, negate_31)
  dot_8 = s8[16,16] dot(dot_10, add_19), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  add_4 = s8[16,16] add(input_2, dot_8)
  subtract_1 = s8[16,16] subtract(add_4, add_4)
  subtract_0 = s8[16,16] subtract(add_4, subtract_1)
  add_5 = s8[16,16] add(input_2, subtract_0)
