HloModule xla_computation_unknown, entry_computation_layout={(s8[16,1],s8[16,16],s8[16,1])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_0 = s8[16,1] parameter(0)
  broadcast_0 = s8[16,16] broadcast(input_0), dimensions={0,1}
  input_6 = s8[16,16] parameter(1)
  input_13 = s8[16,1] parameter(2)
  broadcast_13 = s8[16,16] broadcast(input_13), dimensions={0,1}
  reverse_14 = s8[16,16] reverse(broadcast_13), dimensions={0,1}
  clamp_lo_10 = s8[] constant(-10)
  clamp_lo_bc_10 = s8[16,16] broadcast(clamp_lo_10), dimensions={}
  clamp_hi_10 = s8[] constant(7)
  clamp_hi_bc_10 = s8[16,16] broadcast(clamp_hi_10), dimensions={}
  clamp_10 = s8[16,16] clamp(clamp_lo_bc_10, reverse_14, clamp_hi_bc_10)
  negate_8 = s8[16,16] negate(clamp_10)
  add_1 = s8[16,16] add(negate_8, clamp_10)
  clamp_lo_16 = s8[] constant(-12)
  clamp_lo_bc_16 = s8[16,16] broadcast(clamp_lo_16), dimensions={}
  clamp_hi_16 = s8[] constant(16)
  clamp_hi_bc_16 = s8[16,16] broadcast(clamp_hi_16), dimensions={}
  clamp_16 = s8[16,16] clamp(clamp_lo_bc_16, input_6, clamp_hi_bc_16)
  reverse_17 = s8[16,16] reverse(broadcast_0), dimensions={0,1}
  reverse_9 = s8[16,16] reverse(reverse_17), dimensions={0,1}
  add_11 = s8[16,16] add(clamp_16, reverse_17)
  clamp_lo_22 = s8[] constant(-5)
  clamp_lo_bc_22 = s8[16,16] broadcast(clamp_lo_22), dimensions={}
  clamp_hi_22 = s8[] constant(10)
  clamp_hi_bc_22 = s8[16,16] broadcast(clamp_hi_22), dimensions={}
  clamp_22 = s8[16,16] clamp(clamp_lo_bc_22, reverse_17, clamp_hi_bc_22)
  reverse_23 = s8[16,16] reverse(clamp_22), dimensions={0,1}
  constant_24 = s8[] constant(-12)
  broadcast_24 = s8[16,16] broadcast(constant_24), dimensions={}
  clamp_lo_25 = s8[] constant(-4)
  clamp_lo_bc_25 = s8[16,16] broadcast(clamp_lo_25), dimensions={}
  clamp_hi_25 = s8[] constant(18)
  clamp_hi_bc_25 = s8[16,16] broadcast(clamp_hi_25), dimensions={}
  clamp_25 = s8[16,16] clamp(clamp_lo_bc_25, broadcast_24, clamp_hi_bc_25)
  clamp_lo_19 = s8[] constant(-18)
  clamp_lo_bc_19 = s8[16,16] broadcast(clamp_lo_19), dimensions={}
  clamp_hi_19 = s8[] constant(6)
  clamp_hi_bc_19 = s8[16,16] broadcast(clamp_hi_19), dimensions={}
  clamp_19 = s8[16,16] clamp(clamp_lo_bc_19, clamp_25, clamp_hi_bc_19)
  reverse_15 = s8[16,16] reverse(clamp_19), dimensions={0,1}
  subtract_7 = s8[16,16] subtract(negate_8, reverse_15)
  add_5 = s8[16,16] add(clamp_16, subtract_7)
  add_3 = s8[16,16] add(reverse_9, add_5)
  reverse_2 = s8[16,16] reverse(add_3), dimensions={0,1}
  reverse_4 = s8[16,16] reverse(add_3), dimensions={0,1}
  subtract_12 = s8[16,16] subtract(reverse_15, add_3)
  subtract_20 = s8[16,16] subtract(add_5, input_6)
  add_21 = s8[16,16] add(subtract_7, reverse_4)
  concat_0 = s8[16,16] add(add_1, add_11)
  concat_1 = s8[16,16] add(concat_0, reverse_23)
  concat_2 = s8[16,16] add(concat_1, reverse_2)
  concat_3 = s8[16,16] add(concat_2, subtract_12)
  concat_4 = s8[16,16] add(concat_3, subtract_20)
  concat_5 = s8[16,16] add(concat_4, add_21)
  concat_5_reduced = s8[16] reduce(concat_5, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_5_reshaped = s8[16,1] reshape(concat_5_reduced)
}
