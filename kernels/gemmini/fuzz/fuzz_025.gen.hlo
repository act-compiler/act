HloModule xla_computation_unknown, entry_computation_layout={(s8[16,1],s8[16,16])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_8 = s8[16,1] parameter(0)
  broadcast_8 = s8[16,16] broadcast(input_8), dimensions={0,1}
  negate_13 = s8[16,16] negate(broadcast_8)
  constant_14 = s8[] constant(-10)
  broadcast_14 = s8[16,16] broadcast(constant_14), dimensions={}
  clamp_lo_17 = s8[] constant(-20)
  clamp_lo_bc_17 = s8[16,16] broadcast(clamp_lo_17), dimensions={}
  clamp_hi_17 = s8[] constant(24)
  clamp_hi_bc_17 = s8[16,16] broadcast(clamp_hi_17), dimensions={}
  clamp_17 = s8[16,16] clamp(clamp_lo_bc_17, negate_13, clamp_hi_bc_17)
  constant_18 = s8[] constant(-6)
  broadcast_18 = s8[16,16] broadcast(constant_18), dimensions={}
  input_19 = s8[16,16] parameter(1)
  dot_20 = s8[16,16] dot(broadcast_18, input_19), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  reverse_21 = s8[16,16] reverse(broadcast_14), dimensions={0,1}
  dot_11 = s8[16,16] dot(dot_20, reverse_21), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  dot_16 = s8[16,16] dot(dot_20, reverse_21), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  clamp_lo_12 = s8[] constant(-12)
  clamp_lo_bc_12 = s8[16,16] broadcast(clamp_lo_12), dimensions={}
  clamp_hi_12 = s8[] constant(2)
  clamp_hi_bc_12 = s8[16,16] broadcast(clamp_hi_12), dimensions={}
  clamp_12 = s8[16,16] clamp(clamp_lo_bc_12, dot_16, clamp_hi_bc_12)
  subtract_10 = s8[16,16] subtract(clamp_12, negate_13)
  negate_2 = s8[16,16] negate(subtract_10)
  clamp_lo_4 = s8[] constant(-2)
  clamp_lo_bc_4 = s8[16,16] broadcast(clamp_lo_4), dimensions={}
  clamp_hi_4 = s8[] constant(4)
  clamp_hi_bc_4 = s8[16,16] broadcast(clamp_hi_4), dimensions={}
  clamp_4 = s8[16,16] clamp(clamp_lo_bc_4, subtract_10, clamp_hi_bc_4)
  reverse_3 = s8[16,16] reverse(clamp_4), dimensions={0,1}
  subtract_1 = s8[16,16] subtract(reverse_3, reverse_3)
  reverse_0 = s8[16,16] reverse(subtract_1), dimensions={0,1}
  subtract_5 = s8[16,16] subtract(reverse_3, subtract_1)
  add_6 = s8[16,16] add(subtract_1, subtract_1)
  clamp_lo_7 = s8[] constant(-16)
  clamp_lo_bc_7 = s8[16,16] broadcast(clamp_lo_7), dimensions={}
  clamp_hi_7 = s8[] constant(16)
  clamp_hi_bc_7 = s8[16,16] broadcast(clamp_hi_7), dimensions={}
  clamp_7 = s8[16,16] clamp(clamp_lo_bc_7, subtract_10, clamp_hi_bc_7)
  add_9 = s8[16,16] add(subtract_1, broadcast_8)
  concat_0 = s8[16,16] add(clamp_17, dot_11)
  concat_1 = s8[16,16] add(concat_0, negate_2)
  concat_2 = s8[16,16] add(concat_1, reverse_0)
  concat_3 = s8[16,16] add(concat_2, subtract_5)
  concat_4 = s8[16,16] add(concat_3, add_6)
  concat_5 = s8[16,16] add(concat_4, clamp_7)
  concat_6 = s8[16,16] add(concat_5, add_9)
  concat_6_reduced = s8[16] reduce(concat_6, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_6_reshaped = s8[16,1] reshape(concat_6_reduced)
}
