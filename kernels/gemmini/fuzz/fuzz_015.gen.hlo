HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16])->s8[16,16]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_10 = s8[] constant(25)
  broadcast_10 = s8[16,16] broadcast(constant_10), dimensions={}
  input_12 = s8[16,16] parameter(0)
  constant_14 = s8[] constant(-10)
  broadcast_14 = s8[16,16] broadcast(constant_14), dimensions={}
  subtract_15 = s8[16,16] subtract(broadcast_10, broadcast_14)
  subtract_13 = s8[16,16] subtract(subtract_15, input_12)
  clamp_lo_11 = s8[] constant(-30)
  clamp_lo_bc_11 = s8[16,16] broadcast(clamp_lo_11), dimensions={}
  clamp_hi_11 = s8[] constant(11)
  clamp_hi_bc_11 = s8[16,16] broadcast(clamp_hi_11), dimensions={}
  clamp_11 = s8[16,16] clamp(clamp_lo_bc_11, subtract_13, clamp_hi_bc_11)
  clamp_lo_8 = s8[] constant(-15)
  clamp_lo_bc_8 = s8[16,16] broadcast(clamp_lo_8), dimensions={}
  clamp_hi_8 = s8[] constant(5)
  clamp_hi_bc_8 = s8[16,16] broadcast(clamp_hi_8), dimensions={}
  clamp_8 = s8[16,16] clamp(clamp_lo_bc_8, clamp_11, clamp_hi_bc_8)
  negate_7 = s8[16,16] negate(clamp_8)
  reverse_6 = s8[16,16] reverse(negate_7), dimensions={0,1}
  clamp_lo_5 = s8[] constant(-14)
  clamp_lo_bc_5 = s8[16,16] broadcast(clamp_lo_5), dimensions={}
  clamp_hi_5 = s8[] constant(6)
  clamp_hi_bc_5 = s8[16,16] broadcast(clamp_hi_5), dimensions={}
  clamp_5 = s8[16,16] clamp(clamp_lo_bc_5, reverse_6, clamp_hi_bc_5)
  reverse_1 = s8[16,16] reverse(clamp_5), dimensions={0,1}
  add_2 = s8[16,16] add(clamp_5, reverse_1)
  subtract_3 = s8[16,16] subtract(clamp_5, clamp_5)
  add_4 = s8[16,16] add(clamp_5, negate_7)
  negate_9 = s8[16,16] negate(clamp_5)
  concat_0 = s8[16,16] add(add_2, subtract_3)
  concat_1 = s8[16,16] add(concat_0, add_4)
  ROOT concat_2 = s8[16,16] add(concat_1, negate_9)
}
