HloModule xla_computation_unknown, entry_computation_layout={(s8[16,1],s8[16,16],s8[16,16],s8[16,16],s8[16,16],s8[16,16])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_0 = s8[] constant(2)
  broadcast_0 = s8[16,16] broadcast(constant_0), dimensions={}
  input_4 = s8[16,1] parameter(0)
  broadcast_4 = s8[16,16] broadcast(input_4), dimensions={0,1}
  constant_6 = s8[] constant(-17)
  broadcast_6 = s8[16,16] broadcast(constant_6), dimensions={}
