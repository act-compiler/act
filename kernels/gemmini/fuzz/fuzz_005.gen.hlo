HloModule xla_computation_unknown, entry_computation_layout={(s8[16,1],s8[16,16])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_0 = s8[] constant(-19)
  broadcast_0 = s8[16,16] broadcast(constant_0), dimensions={}
  input_7 = s8[16,1] parameter(0)
  broadcast_7 = s8[16,16] broadcast(input_7), dimensions={0,1}
  reverse_8 = s8[16,16] reverse(broadcast_7), dimensions={0,1}
  clamp_lo_4 = s8[] constant(-22)
  clamp_lo_bc_4 = s8[16,16] broadcast(clamp_lo_4), dimensions={}
  clamp_hi_4 = s8[] constant(11)
  clamp_hi_bc_4 = s8[16,16] broadcast(clamp_hi_4), dimensions={}
  clamp_4 = s8[16,16] clamp(clamp_lo_bc_4, reverse_8, clamp_hi_bc_4)
  negate_5 = s8[16,16] negate(reverse_8)
  input_9 = s8[16,16] parameter(1)
  subtract_10 = s8[16,16] subtract(broadcast_0, input_9)
  add_1 = s8[16,16] add(subtract_10, clamp_4)
  subtract_3 = s8[16,16] subtract(clamp_4, subtract_10)
  add_6 = s8[16,16] add(add_1, reverse_8)
  concat_0 = s8[16,16] add(negate_5, subtract_3)
  concat_1 = s8[16,16] add(concat_0, add_6)
  concat_1_reduced = s8[16] reduce(concat_1, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_1_reshaped = s8[16,1] reshape(concat_1_reduced)
}
