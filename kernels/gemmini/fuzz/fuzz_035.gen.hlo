HloModule xla_computation_unknown, entry_computation_layout={(s8[16,1],s8[16,1],s8[16,1],s8[16,16])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_10 = s8[16,1] parameter(0)
  broadcast_10 = s8[16,16] broadcast(input_10), dimensions={0,1}
  input_11 = s8[16,1] parameter(1)
  broadcast_11 = s8[16,16] broadcast(input_11), dimensions={0,1}
  constant_13 = s8[] constant(-2)
  broadcast_13 = s8[16,16] broadcast(constant_13), dimensions={}
  constant_18 = s8[] constant(-2)
  broadcast_18 = s8[16,16] broadcast(constant_18), dimensions={}
  constant_20 = s8[] constant(-18)
  broadcast_20 = s8[16,16] broadcast(constant_20), dimensions={}
  input_22 = s8[16,1] parameter(2)
  broadcast_22 = s8[16,16] broadcast(input_22), dimensions={0,1}
  add_23 = s8[16,16] add(broadcast_10, broadcast_22)
  dot_21 = s8[16,16] dot(broadcast_13, add_23), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  clamp_lo_16 = s8[] constant(-7)
  clamp_lo_bc_16 = s8[16,16] broadcast(clamp_lo_16), dimensions={}
  clamp_hi_16 = s8[] constant(18)
  clamp_hi_bc_16 = s8[16,16] broadcast(clamp_hi_16), dimensions={}
  clamp_16 = s8[16,16] clamp(clamp_lo_bc_16, dot_21, clamp_hi_bc_16)
  constant_24 = s8[] constant(6)
  broadcast_24 = s8[16,16] broadcast(constant_24), dimensions={}
  input_28 = s8[16,16] parameter(3)
  reverse_29 = s8[16,16] reverse(input_28), dimensions={0,1}
  minimum_25 = s8[16,16] minimum(reverse_29, broadcast_24)
  negate_6 = s8[16,16] negate(minimum_25)
  subtract_9 = s8[16,16] subtract(negate_6, minimum_25)
  constant_30 = s8[] constant(18)
  broadcast_30 = s8[16,16] broadcast(constant_30), dimensions={}
  add_31 = s8[16,16] add(broadcast_20, broadcast_30)
  dot_19 = s8[16,16] dot(add_31, broadcast_18), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  dot_15 = s8[16,16] dot(dot_19, clamp_16), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  add_12 = s8[16,16] add(dot_15, broadcast_11)
  add_5 = s8[16,16] add(add_12, negate_6)
  add_1 = s8[16,16] add(add_5, add_5)
  reverse_2 = s8[16,16] reverse(add_1), dimensions={0,1}
  reverse_4 = s8[16,16] reverse(reverse_2), dimensions={0,1}
  subtract_7 = s8[16,16] subtract(add_12, add_12)
  dot_3 = s8[16,16] dot(broadcast_11, subtract_7), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  negate_8 = s8[16,16] negate(add_12)
  reverse_0 = s8[16,16] reverse(negate_8), dimensions={0,1}
  reverse_14 = s8[16,16] reverse(subtract_7), dimensions={0,1}
  subtract_26 = s8[16,16] subtract(dot_19, negate_6)
  clamp_lo_27 = s8[] constant(-15)
  clamp_lo_bc_27 = s8[16,16] broadcast(clamp_lo_27), dimensions={}
  clamp_hi_27 = s8[] constant(26)
  clamp_hi_bc_27 = s8[16,16] broadcast(clamp_hi_27), dimensions={}
  clamp_27 = s8[16,16] clamp(clamp_lo_bc_27, subtract_7, clamp_hi_bc_27)
  concat_0 = s8[16,16] add(subtract_9, reverse_4)
  concat_1 = s8[16,16] add(concat_0, dot_3)
  concat_2 = s8[16,16] add(concat_1, reverse_0)
  concat_3 = s8[16,16] add(concat_2, reverse_14)
  concat_4 = s8[16,16] add(concat_3, subtract_26)
  concat_5 = s8[16,16] add(concat_4, clamp_27)
  concat_5_reduced = s8[16] reduce(concat_5, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_5_reshaped = s8[16,1] reshape(concat_5_reduced)
}
