HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16],s8[16,16],s8[16,1])->s8[16,16]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_3 = s8[16,16] parameter(0)
  input_5 = s8[16,16] parameter(1)
  constant_7 = s8[] constant(-25)
  broadcast_7 = s8[16,16] broadcast(constant_7), dimensions={}
  subtract_8 = s8[16,16] subtract(input_3, broadcast_7)
  constant_11 = s8[] constant(-28)
  broadcast_11 = s8[16,16] broadcast(constant_11), dimensions={}
  input_12 = s8[16,1] parameter(2)
  broadcast_12 = s8[16,16] broadcast(input_12), dimensions={0,1}
  add_13 = s8[16,16] add(broadcast_11, broadcast_12)
  subtract_2 = s8[16,16] subtract(subtract_8, add_13)
  add_6 = s8[16,16] add(subtract_8, add_13)
  constant_14 = s8[] constant(-28)
  broadcast_14 = s8[16,16] broadcast(constant_14), dimensions={}
  add_15 = s8[16,16] add(input_5, broadcast_14)
  reverse_10 = s8[16,16] reverse(add_15), dimensions={0,1}
  add_4 = s8[16,16] add(reverse_10, add_6)
  add_1 = s8[16,16] add(add_4, add_4)
  negate_0 = s8[16,16] negate(add_1)
  ROOT concat_0 = s8[16,16] add(subtract_2, negate_0)
}
