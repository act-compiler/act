  add_13 = s8[16,16] add(subtract_2, subtract_11)
  subtract_14 = s8[16,16] subtract(subtract_6, subtract_11)
  add_19 = s8[16,16] add(input_10, negate_3)
  negate_20 = s8[16,16] negate(add_4)
  negate_21 = s8[16,16] negate(negate_12)
  subtract_22 = s8[16,16] subtract(negate_3, negate_8)
  add_25 = s8[16,16] add(add_13, negate_37)
