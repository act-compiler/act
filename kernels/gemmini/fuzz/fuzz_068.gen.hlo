  add_26 = s8[16,16] add(negate_47, subtract_40)
  subtract_18 = s8[16,16] subtract(add_26, broadcast_17)
  subtract_11 = s8[16,16] subtract(subtract_18, input_10)
  subtract_7 = s8[16,16] subtract(negate_8, subtract_11)
  negate_5 = s8[16,16] negate(subtract_7)
  negate_3 = s8[16,16] negate(negate_5)
  negate_1 = s8[16,16] negate(negate_3)
