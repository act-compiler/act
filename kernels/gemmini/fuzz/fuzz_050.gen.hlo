  minimum_22 = s8[16,16] minimum(clamp_32, broadcast_17)
  constant_33 = s8[] constant(-21)
  broadcast_33 = s8[16,16] broadcast(constant_33), dimensions={}
  constant_34 = s8[] constant(-23)
  broadcast_34 = s8[16,16] broadcast(constant_34), dimensions={}
  negate_29 = s8[16,16] negate(broadcast_34)
  minimum_35 = s8[16,16] minimum(broadcast_33, broadcast_34)
  add_30 = s8[16,16] add(clamp_32, minimum_35)
  maximum_25 = s8[16,16] maximum(broadcast_19, add_30)
  clamp_lo_16 = s8[] constant(-6)
  clamp_lo_bc_16 = s8[16,16] broadcast(clamp_lo_16), dimensions={}
  clamp_hi_16 = s8[] constant(18)
  clamp_hi_bc_16 = s8[16,16] broadcast(clamp_hi_16), dimensions={}
  clamp_16 = s8[16,16] clamp(clamp_lo_bc_16, maximum_25, clamp_hi_bc_16)
  reverse_15 = s8[16,16] reverse(clamp_16), dimensions={0,1}
  negate_12 = s8[16,16] negate(reverse_15)
  constant_36 = s8[] constant(3)
  broadcast_36 = s8[16,16] broadcast(constant_36), dimensions={}
  input_37 = s8[16,1] parameter(3)
  broadcast_37 = s8[16,16] broadcast(input_37), dimensions={0,1}
  maximum_38 = s8[16,16] maximum(broadcast_36, broadcast_37)
  add_23 = s8[16,16] add(clamp_28, maximum_38)
  dot_21 = s8[16,16] dot(add_23, input_20), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  subtract_18 = s8[16,16] subtract(dot_21, broadcast_17)
  add_14 = s8[16,16] add(subtract_18, input_13)
  reverse_7 = s8[16,16] reverse(add_14), dimensions={0,1}
  subtract_6 = s8[16,16] subtract(negate_12, reverse_7)
  reverse_4 = s8[16,16] reverse(subtract_6), dimensions={0,1}
  negate_1 = s8[16,16] negate(reverse_4)
  subtract_2 = s8[16,16] subtract(reverse_4, negate_1)
  subtract_5 = s8[16,16] subtract(reverse_4, reverse_7)
  subtract_0 = s8[16,16] subtract(subtract_5, reverse_4)
  negate_8 = s8[16,16] negate(negate_1)
  negate_9 = s8[16,16] negate(negate_8)
  add_10 = s8[16,16] add(subtract_5, subtract_2)
  reverse_11 = s8[16,16] reverse(subtract_6), dimensions={0,1}
  add_3 = s8[16,16] add(maximum_38, reverse_11)
  negate_24 = s8[16,16] negate(subtract_6)
  subtract_26 = s8[16,16] subtract(add_30, subtract_5)
  clamp_lo_39 = s8[] constant(-1)
  clamp_lo_bc_39 = s8[16,16] broadcast(clamp_lo_39), dimensions={}
