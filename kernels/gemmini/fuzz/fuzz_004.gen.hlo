HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16],s8[16,16])->s8[16,16]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_4 = s8[16,16] parameter(0)
  input_7 = s8[16,16] parameter(1)
  constant_8 = s8[] constant(-7)
  broadcast_8 = s8[16,16] broadcast(constant_8), dimensions={}
  subtract_9 = s8[16,16] subtract(input_7, broadcast_8)
  constant_10 = s8[] constant(-8)
  broadcast_10 = s8[16,16] broadcast(constant_10), dimensions={}
  dot_11 = s8[16,16] dot(input_4, broadcast_10), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  add_6 = s8[16,16] add(subtract_9, dot_11)
  subtract_1 = s8[16,16] subtract(add_6, add_6)
  clamp_lo_2 = s8[] constant(-7)
  clamp_lo_bc_2 = s8[16,16] broadcast(clamp_lo_2), dimensions={}
  clamp_hi_2 = s8[] constant(32)
  clamp_hi_bc_2 = s8[16,16] broadcast(clamp_hi_2), dimensions={}
  clamp_2 = s8[16,16] clamp(clamp_lo_bc_2, subtract_1, clamp_hi_bc_2)
  add_3 = s8[16,16] add(add_6, add_6)
  subtract_0 = s8[16,16] subtract(subtract_1, add_3)
  ROOT concat_0 = s8[16,16] add(clamp_2, subtract_0)
}
