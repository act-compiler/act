HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16],s8[16,1])->s8[16,16]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_7 = s8[16,16] parameter(0)
  reverse_10 = s8[16,16] reverse(input_7), dimensions={0,1}
  input_12 = s8[16,1] parameter(1)
  broadcast_12 = s8[16,16] broadcast(input_12), dimensions={0,1}
  negate_13 = s8[16,16] negate(broadcast_12)
  subtract_9 = s8[16,16] subtract(input_7, negate_13)
  negate_6 = s8[16,16] negate(subtract_9)
  add_1 = s8[16,16] add(negate_6, negate_6)
  subtract_2 = s8[16,16] subtract(negate_6, add_1)
  add_0 = s8[16,16] add(negate_6, subtract_2)
  subtract_3 = s8[16,16] subtract(subtract_2, add_1)
  subtract_4 = s8[16,16] subtract(subtract_2, negate_6)
  reverse_5 = s8[16,16] reverse(subtract_4), dimensions={0,1}
  add_8 = s8[16,16] add(subtract_2, add_0)
  subtract_11 = s8[16,16] subtract(subtract_9, subtract_3)
  subtract_14 = s8[16,16] subtract(subtract_9, negate_6)
  reverse_15 = s8[16,16] reverse(input_7), dimensions={0,1}
  concat_0 = s8[16,16] add(reverse_10, reverse_5)
  concat_1 = s8[16,16] add(concat_0, add_8)
  concat_2 = s8[16,16] add(concat_1, subtract_11)
  concat_3 = s8[16,16] add(concat_2, subtract_14)
  ROOT concat_4 = s8[16,16] add(concat_3, reverse_15)
}
