HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16],s8[16,16])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_3 = s8[] constant(18)
  broadcast_3 = s8[16,16] broadcast(constant_3), dimensions={}
  constant_4 = s8[] constant(-12)
  broadcast_4 = s8[16,16] broadcast(constant_4), dimensions={}
  input_10 = s8[16,16] parameter(0)
  input_12 = s8[16,16] parameter(1)
  maximum_13 = s8[16,16] maximum(broadcast_4, input_12)
  reverse_9 = s8[16,16] reverse(maximum_13), dimensions={0,1}
  subtract_11 = s8[16,16] subtract(maximum_13, input_10)
  negate_16 = s8[16,16] negate(broadcast_3)
  clamp_lo_15 = s8[] constant(-6)
  clamp_lo_bc_15 = s8[16,16] broadcast(clamp_lo_15), dimensions={}
  clamp_hi_15 = s8[] constant(15)
  clamp_hi_bc_15 = s8[16,16] broadcast(clamp_hi_15), dimensions={}
  clamp_15 = s8[16,16] clamp(clamp_lo_bc_15, negate_16, clamp_hi_bc_15)
  add_5 = s8[16,16] add(clamp_15, subtract_11)
  negate_0 = s8[16,16] negate(add_5)
  add_1 = s8[16,16] add(add_5, add_5)
  subtract_2 = s8[16,16] subtract(add_5, add_5)
  add_6 = s8[16,16] add(negate_0, clamp_15)
  subtract_7 = s8[16,16] subtract(negate_0, add_5)
  add_8 = s8[16,16] add(subtract_7, subtract_2)
  add_14 = s8[16,16] add(subtract_7, add_8)
  negate_17 = s8[16,16] negate(negate_0)
  subtract_18 = s8[16,16] subtract(add_8, negate_17)
  concat_0 = s8[16,16] add(reverse_9, add_1)
  concat_1 = s8[16,16] add(concat_0, add_6)
  concat_2 = s8[16,16] add(concat_1, add_14)
  concat_3 = s8[16,16] add(concat_2, subtract_18)
  concat_3_reduced = s8[16] reduce(concat_3, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_3_reshaped = s8[16,1] reshape(concat_3_reduced)
}
