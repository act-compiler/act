HloModule xla_computation_unknown, entry_computation_layout={(s8[16,1])->s8[16,16]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_0 = s8[] constant(-23)
  broadcast_0 = s8[16,16] broadcast(constant_0), dimensions={}
  input_5 = s8[16,1] parameter(0)
  broadcast_5 = s8[16,16] broadcast(input_5), dimensions={0,1}
  subtract_6 = s8[16,16] subtract(broadcast_5, broadcast_0)
  constant_8 = s8[] constant(-16)
  broadcast_8 = s8[16,16] broadcast(constant_8), dimensions={}
  subtract_9 = s8[16,16] subtract(broadcast_0, broadcast_8)
  add_7 = s8[16,16] add(broadcast_5, subtract_9)
  add_1 = s8[16,16] add(add_7, add_7)
  add_2 = s8[16,16] add(add_1, add_1)
  add_3 = s8[16,16] add(add_2, add_1)
  clamp_lo_4 = s8[] constant(-19)
  clamp_lo_bc_4 = s8[16,16] broadcast(clamp_lo_4), dimensions={}
  clamp_hi_4 = s8[] constant(3)
  clamp_hi_bc_4 = s8[16,16] broadcast(clamp_hi_4), dimensions={}
  clamp_4 = s8[16,16] clamp(clamp_lo_bc_4, add_7, clamp_hi_bc_4)
  subtract_10 = s8[16,16] subtract(add_2, clamp_4)
  clamp_lo_11 = s8[] constant(-13)
  clamp_lo_bc_11 = s8[16,16] broadcast(clamp_lo_11), dimensions={}
  clamp_hi_11 = s8[] constant(4)
  clamp_hi_bc_11 = s8[16,16] broadcast(clamp_hi_11), dimensions={}
  clamp_11 = s8[16,16] clamp(clamp_lo_bc_11, clamp_4, clamp_hi_bc_11)
  concat_0 = s8[16,16] add(subtract_6, add_3)
  concat_1 = s8[16,16] add(concat_0, subtract_10)
  ROOT concat_2 = s8[16,16] add(concat_1, clamp_11)
}
