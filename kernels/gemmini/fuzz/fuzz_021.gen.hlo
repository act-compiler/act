  clamp_hi_bc_9 = s8[16,16] broadcast(clamp_hi_9), dimensions={}
  clamp_9 = s8[16,16] clamp(clamp_lo_bc_9, minimum_12, clamp_hi_bc_9)
  maximum_3 = s8[16,16] maximum(broadcast_4, clamp_9)
  input_19 = s8[16,1] parameter(1)
