  constant_20 = s8[] constant(-31)
  broadcast_20 = s8[16,16] broadcast(constant_20), dimensions={}
  minimum_21 = s8[16,16] minimum(broadcast_19, broadcast_20)
  negate_10 = s8[16,16] negate(minimum_21)
  subtract_8 = s8[16,16] subtract(negate_10, clamp_9)
  minimum_5 = s8[16,16] minimum(subtract_8, broadcast_4)
  subtract_0 = s8[16,16] subtract(minimum_5, minimum_5)
  clamp_lo_1 = s8[] constant(-29)
  clamp_lo_bc_1 = s8[16,16] broadcast(clamp_lo_1), dimensions={}
