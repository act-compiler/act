  subtract_2 = s8[16,16] subtract(clamp_1, minimum_5)
  add_11 = s8[16,16] add(negate_10, subtract_8)
  subtract_7 = s8[16,16] subtract(broadcast_19, add_11)
  negate_14 = s8[16,16] negate(subtract_0)
  concat_0 = s8[16,16] add(maximum_3, subtract_2)
  concat_1 = s8[16,16] add(concat_0, subtract_7)
  ROOT concat_2 = s8[16,16] add(concat_1, negate_14)
