HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16],s8[16,1],s8[16,1],s8[16,1])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_0 = s8[] constant(30)
  broadcast_0 = s8[16,16] broadcast(constant_0), dimensions={}
  constant_1 = s8[] constant(-23)
  broadcast_1 = s8[16,16] broadcast(constant_1), dimensions={}
  input_12 = s8[16,16] parameter(0)
  input_16 = s8[16,1] parameter(1)
  broadcast_16 = s8[16,16] broadcast(input_16), dimensions={0,1}
  maximum_17 = s8[16,16] maximum(broadcast_1, broadcast_16)
  reverse_18 = s8[16,16] reverse(input_12), dimensions={0,1}
  reverse_15 = s8[16,16] reverse(reverse_18), dimensions={0,1}
  reverse_10 = s8[16,16] reverse(reverse_15), dimensions={0,1}
  reverse_9 = s8[16,16] reverse(reverse_10), dimensions={0,1}
  input_20 = s8[16,1] parameter(2)
  broadcast_20 = s8[16,16] broadcast(input_20), dimensions={0,1}
  maximum_21 = s8[16,16] maximum(broadcast_0, broadcast_20)
  add_14 = s8[16,16] add(maximum_17, maximum_21)
  clamp_lo_6 = s8[] constant(-9)
  clamp_lo_bc_6 = s8[16,16] broadcast(clamp_lo_6), dimensions={}
  clamp_hi_6 = s8[] constant(9)
  clamp_hi_bc_6 = s8[16,16] broadcast(clamp_hi_6), dimensions={}
  clamp_6 = s8[16,16] clamp(clamp_lo_bc_6, add_14, clamp_hi_bc_6)
  input_24 = s8[16,1] parameter(3)
  broadcast_24 = s8[16,16] broadcast(input_24), dimensions={0,1}
  reverse_25 = s8[16,16] reverse(broadcast_24), dimensions={0,1}
  add_13 = s8[16,16] add(maximum_21, reverse_25)
  negate_19 = s8[16,16] negate(reverse_25)
  subtract_5 = s8[16,16] subtract(negate_19, clamp_6)
  add_3 = s8[16,16] add(reverse_9, subtract_5)
  clamp_lo_4 = s8[] constant(-14)
  clamp_lo_bc_4 = s8[16,16] broadcast(clamp_lo_4), dimensions={}
  clamp_hi_4 = s8[] constant(27)
  clamp_hi_bc_4 = s8[16,16] broadcast(clamp_hi_4), dimensions={}
  clamp_4 = s8[16,16] clamp(clamp_lo_bc_4, add_3, clamp_hi_bc_4)
  clamp_lo_7 = s8[] constant(-9)
  clamp_lo_bc_7 = s8[16,16] broadcast(clamp_lo_7), dimensions={}
  clamp_hi_7 = s8[] constant(14)
  clamp_hi_bc_7 = s8[16,16] broadcast(clamp_hi_7), dimensions={}
  clamp_7 = s8[16,16] clamp(clamp_lo_bc_7, negate_19, clamp_hi_bc_7)
  add_8 = s8[16,16] add(reverse_9, clamp_4)
  subtract_11 = s8[16,16] subtract(add_8, reverse_10)
  negate_22 = s8[16,16] negate(subtract_11)
  add_23 = s8[16,16] add(subtract_11, add_3)
  concat_0 = s8[16,16] add(add_13, clamp_7)
  concat_1 = s8[16,16] add(concat_0, negate_22)
  concat_2 = s8[16,16] add(concat_1, add_23)
  concat_2_reduced = s8[16] reduce(concat_2, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_2_reshaped = s8[16,1] reshape(concat_2_reduced)
}
