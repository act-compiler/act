  clamp_hi_bc_1 = s8[16,16] broadcast(clamp_hi_1), dimensions={}
  clamp_1 = s8[16,16] clamp(clamp_lo_bc_1, add_5, clamp_hi_bc_1)
  maximum_12 = s8[16,16] maximum(clamp_1, broadcast_11)
  add_25 = s8[16,16] add(add_5, subtract_0)
  input_36 = s8[16,16] parameter(3)
  maximum_37 = s8[16,16] maximum(broadcast_22, input_36)
