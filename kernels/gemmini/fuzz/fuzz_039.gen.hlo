  clamp_lo_27 = s8[] constant(-6)
  clamp_lo_bc_27 = s8[16,16] broadcast(clamp_lo_27), dimensions={}
  clamp_hi_27 = s8[] constant(28)
  clamp_hi_bc_27 = s8[16,16] broadcast(clamp_hi_27), dimensions={}
  clamp_27 = s8[16,16] clamp(clamp_lo_bc_27, broadcast_15, clamp_hi_bc_27)
  maximum_22 = s8[16,16] maximum(broadcast_20, clamp_27)
  negate_10 = s8[16,16] negate(maximum_22)
  reverse_3 = s8[16,16] reverse(negate_10), dimensions={0,1}
  add_9 = s8[16,16] add(negate_10, clamp_16)
  reverse_11 = s8[16,16] reverse(add_9), dimensions={0,1}
  constant_29 = s8[] constant(16)
