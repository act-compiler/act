  maximum_31 = s8[16,16] maximum(broadcast_29, broadcast_30)
  add_14 = s8[16,16] add(maximum_31, subtract_25)
  add_5 = s8[16,16] add(add_9, add_14)
  negate_1 = s8[16,16] negate(add_5)
  subtract_0 = s8[16,16] subtract(negate_1, negate_1)
  negate_2 = s8[16,16] negate(negate_1)
  add_4 = s8[16,16] add(negate_2, subtract_0)
  add_6 = s8[16,16] add(subtract_0, subtract_0)
  clamp_lo_7 = s8[] constant(-29)
  clamp_lo_bc_7 = s8[16,16] broadcast(clamp_lo_7), dimensions={}
  clamp_hi_7 = s8[] constant(31)
