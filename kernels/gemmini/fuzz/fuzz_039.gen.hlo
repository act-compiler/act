  negate_8 = s8[16,16] negate(subtract_0)
  reverse_18 = s8[16,16] reverse(negate_8), dimensions={0,1}
  reverse_19 = s8[16,16] reverse(negate_2), dimensions={0,1}
  subtract_21 = s8[16,16] subtract(reverse_18, clamp_17)
  add_28 = s8[16,16] add(negate_1, reverse_11)
  concat_0 = s8[16,16] add(reverse_3, add_4)
  concat_1 = s8[16,16] add(concat_0, add_6)
