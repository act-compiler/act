HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16],s8[16,1])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_1 = s8[16,16] parameter(0)
  constant_4 = s8[] constant(-16)
  broadcast_4 = s8[16,16] broadcast(constant_4), dimensions={}
  constant_5 = s8[] constant(25)
  broadcast_5 = s8[16,16] broadcast(constant_5), dimensions={}
  constant_8 = s8[] constant(-31)
  broadcast_8 = s8[16,16] broadcast(constant_8), dimensions={}
  clamp_lo_12 = s8[] constant(-25)
  clamp_lo_bc_12 = s8[16,16] broadcast(clamp_lo_12), dimensions={}
  clamp_hi_12 = s8[] constant(13)
  clamp_hi_bc_12 = s8[16,16] broadcast(clamp_hi_12), dimensions={}
  clamp_12 = s8[16,16] clamp(clamp_lo_bc_12, input_1, clamp_hi_bc_12)
  reverse_11 = s8[16,16] reverse(clamp_12), dimensions={0,1}
  negate_2 = s8[16,16] negate(reverse_11)
  input_13 = s8[16,1] parameter(1)
  broadcast_13 = s8[16,16] broadcast(input_13), dimensions={0,1}
  maximum_14 = s8[16,16] maximum(broadcast_8, broadcast_13)
  negate_10 = s8[16,16] negate(maximum_14)
  maximum_9 = s8[16,16] maximum(broadcast_5, negate_10)
  reverse_7 = s8[16,16] reverse(maximum_9), dimensions={0,1}
  maximum_6 = s8[16,16] maximum(broadcast_4, reverse_7)
  add_0 = s8[16,16] add(maximum_6, reverse_11)
  subtract_3 = s8[16,16] subtract(reverse_11, maximum_6)
  add_15 = s8[16,16] add(subtract_3, add_0)
  concat_0 = s8[16,16] add(negate_2, add_15)
  concat_0_reduced = s8[16] reduce(concat_0, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_0_reshaped = s8[16,1] reshape(concat_0_reduced)
}
