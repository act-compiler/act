  minimum_14 = s8[16,16] minimum(add_34, broadcast_13)
  reverse_35 = s8[16,16] reverse(input_12), dimensions={0,1}
  minimum_32 = s8[16,16] minimum(reverse_35, broadcast_31)
  constant_36 = s8[] constant(-1)
