  concat_9 = s8[16,16] add(concat_8, dot_30)
  concat_9_reduced = s8[16] reduce(concat_9, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_9_reshaped = s8[16,1] reshape(concat_9_reduced)
}
