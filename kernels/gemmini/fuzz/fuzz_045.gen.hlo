HloModule xla_computation_unknown, entry_computation_layout={(s8[16,1],s8[16,1],s8[16,16],s8[16,1])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  input_3 = s8[16,1] parameter(0)
  broadcast_3 = s8[16,16] broadcast(input_3), dimensions={0,1}
  constant_10 = s8[] constant(25)
  broadcast_10 = s8[16,16] broadcast(constant_10), dimensions={}
  constant_13 = s8[] constant(-26)
  broadcast_13 = s8[16,16] broadcast(constant_13), dimensions={}
