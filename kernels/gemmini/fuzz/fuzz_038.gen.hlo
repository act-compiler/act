  clamp_lo_bc_4 = s8[16,16] broadcast(clamp_lo_4), dimensions={}
  clamp_hi_4 = s8[] constant(19)
  clamp_hi_bc_4 = s8[16,16] broadcast(clamp_hi_4), dimensions={}
  clamp_4 = s8[16,16] clamp(clamp_lo_bc_4, subtract_26, clamp_hi_bc_4)
  add_9 = s8[16,16] add(reverse_14, subtract_26)
  negate_11 = s8[16,16] negate(clamp_4)
  negate_15 = s8[16,16] negate(clamp_4)
  subtract_16 = s8[16,16] subtract(subtract_19, subtract_26)
  negate_18 = s8[16,16] negate(negate_15)
  add_0 = s8[16,16] add(negate_18, reverse_6)
  input_28 = s8[16,1] parameter(2)
  broadcast_28 = s8[16,16] broadcast(input_28), dimensions={0,1}
  reverse_29 = s8[16,16] reverse(broadcast_28), dimensions={0,1}
  negate_13 = s8[16,16] negate(reverse_29)
  add_7 = s8[16,16] add(negate_13, reverse_14)
  subtract_3 = s8[16,16] subtract(clamp_4, add_7)
  subtract_1 = s8[16,16] subtract(clamp_4, subtract_3)
  subtract_2 = s8[16,16] subtract(subtract_3, subtract_1)
  subtract_5 = s8[16,16] subtract(clamp_4, subtract_3)
  clamp_lo_8 = s8[] constant(-6)
  clamp_lo_bc_8 = s8[16,16] broadcast(clamp_lo_8), dimensions={}
  clamp_hi_8 = s8[] constant(22)
  clamp_hi_bc_8 = s8[16,16] broadcast(clamp_hi_8), dimensions={}
  clamp_8 = s8[16,16] clamp(clamp_lo_bc_8, add_7, clamp_hi_bc_8)
  clamp_lo_10 = s8[] constant(-21)
  clamp_lo_bc_10 = s8[16,16] broadcast(clamp_lo_10), dimensions={}
  clamp_hi_10 = s8[] constant(13)
  clamp_hi_bc_10 = s8[16,16] broadcast(clamp_hi_10), dimensions={}
  clamp_10 = s8[16,16] clamp(clamp_lo_bc_10, add_7, clamp_hi_bc_10)
  subtract_27 = s8[16,16] subtract(subtract_3, subtract_26)
  concat_0 = s8[16,16] add(reverse_12, add_9)
  concat_1 = s8[16,16] add(concat_0, negate_11)
  concat_2 = s8[16,16] add(concat_1, subtract_16)
  concat_3 = s8[16,16] add(concat_2, add_0)
  concat_4 = s8[16,16] add(concat_3, subtract_2)
  concat_5 = s8[16,16] add(concat_4, subtract_5)
