HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_4 = s8[] constant(-27)
  broadcast_4 = s8[16,16] broadcast(constant_4), dimensions={}
  constant_8 = s8[] constant(15)
  broadcast_8 = s8[16,16] broadcast(constant_8), dimensions={}
  input_10 = s8[16,16] parameter(0)
  constant_11 = s8[] constant(8)
  broadcast_11 = s8[16,16] broadcast(constant_11), dimensions={}
  maximum_12 = s8[16,16] maximum(input_10, broadcast_11)
  constant_13 = s8[] constant(8)
  broadcast_13 = s8[16,16] broadcast(constant_13), dimensions={}
  constant_19 = s8[] constant(-27)
  broadcast_19 = s8[16,16] broadcast(constant_19), dimensions={}
  subtract_20 = s8[16,16] subtract(broadcast_4, broadcast_19)
  negate_18 = s8[16,16] negate(subtract_20)
  add_14 = s8[16,16] add(negate_18, broadcast_13)
  maximum_9 = s8[16,16] maximum(add_14, broadcast_8)
  clamp_lo_7 = s8[] constant(-15)
  clamp_lo_bc_7 = s8[16,16] broadcast(clamp_lo_7), dimensions={}
  clamp_hi_7 = s8[] constant(30)
  clamp_hi_bc_7 = s8[16,16] broadcast(clamp_hi_7), dimensions={}
  clamp_7 = s8[16,16] clamp(clamp_lo_bc_7, maximum_9, clamp_hi_bc_7)
  subtract_6 = s8[16,16] subtract(maximum_12, clamp_7)
  subtract_1 = s8[16,16] subtract(add_14, subtract_6)
  reverse_2 = s8[16,16] reverse(subtract_6), dimensions={0,1}
  negate_0 = s8[16,16] negate(reverse_2)
  subtract_3 = s8[16,16] subtract(reverse_2, negate_0)
  reverse_5 = s8[16,16] reverse(negate_0), dimensions={0,1}
  negate_15 = s8[16,16] negate(add_14)
  negate_16 = s8[16,16] negate(subtract_1)
  add_17 = s8[16,16] add(negate_15, broadcast_11)
  dot_21 = s8[16,16] dot(input_10, input_10), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  concat_0 = s8[16,16] add(subtract_3, reverse_5)
  concat_1 = s8[16,16] add(concat_0, negate_16)
  concat_2 = s8[16,16] add(concat_1, add_17)
  concat_3 = s8[16,16] add(concat_2, dot_21)
  concat_3_reduced = s8[16] reduce(concat_3, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_3_reshaped = s8[16,1] reshape(concat_3_reduced)
}
