HloModule xla_computation_unknown, entry_computation_layout={(s8[16,16],s8[16,1],s8[16,1],s8[16,16])->s8[16,1]}

reduce_add {
  lhs = s8[] parameter(0)
  rhs = s8[] parameter(1)
  ROOT sum = s8[] add(lhs, rhs)
}

ENTRY main {
  reduce_init = s8[] constant(0)
  constant_7 = s8[] constant(-24)
  broadcast_7 = s8[16,16] broadcast(constant_7), dimensions={}
  constant_11 = s8[] constant(-31)
  broadcast_11 = s8[16,16] broadcast(constant_11), dimensions={}
  constant_15 = s8[] constant(-29)
  broadcast_15 = s8[16,16] broadcast(constant_15), dimensions={}
  input_20 = s8[16,16] parameter(0)
  input_21 = s8[16,1] parameter(1)
  broadcast_21 = s8[16,16] broadcast(input_21), dimensions={0,1}
  input_23 = s8[16,1] parameter(2)
  broadcast_23 = s8[16,16] broadcast(input_23), dimensions={0,1}
  subtract_24 = s8[16,16] subtract(broadcast_15, broadcast_23)
  input_28 = s8[16,16] parameter(3)
  constant_29 = s8[] constant(2)
  broadcast_29 = s8[16,16] broadcast(constant_29), dimensions={}
  constant_31 = s8[] constant(-11)
  broadcast_31 = s8[16,16] broadcast(constant_31), dimensions={}
  reverse_32 = s8[16,16] reverse(broadcast_31), dimensions={0,1}
  constant_33 = s8[] constant(18)
  broadcast_33 = s8[16,16] broadcast(constant_33), dimensions={}
  minimum_34 = s8[16,16] minimum(input_28, broadcast_33)
  negate_25 = s8[16,16] negate(minimum_34)
  constant_36 = s8[] constant(-17)
  broadcast_36 = s8[16,16] broadcast(constant_36), dimensions={}
  add_37 = s8[16,16] add(broadcast_29, broadcast_36)
  subtract_22 = s8[16,16] subtract(subtract_24, add_37)
  add_16 = s8[16,16] add(negate_25, subtract_22)
  constant_40 = s8[] constant(-10)
  broadcast_40 = s8[16,16] broadcast(constant_40), dimensions={}
  maximum_41 = s8[16,16] maximum(input_20, broadcast_40)
  add_39 = s8[16,16] add(broadcast_21, maximum_41)
  reverse_35 = s8[16,16] reverse(add_39), dimensions={0,1}
  add_30 = s8[16,16] add(reverse_32, reverse_35)
  add_12 = s8[16,16] add(add_30, broadcast_11)
  negate_10 = s8[16,16] negate(add_12)
  add_8 = s8[16,16] add(negate_10, broadcast_7)
  add_1 = s8[16,16] add(add_8, broadcast_15)
  subtract_6 = s8[16,16] subtract(add_16, add_8)
  clamp_lo_2 = s8[] constant(-7)
  clamp_lo_bc_2 = s8[16,16] broadcast(clamp_lo_2), dimensions={}
  clamp_hi_2 = s8[] constant(22)
  clamp_hi_bc_2 = s8[16,16] broadcast(clamp_hi_2), dimensions={}
  clamp_2 = s8[16,16] clamp(clamp_lo_bc_2, subtract_6, clamp_hi_bc_2)
  subtract_0 = s8[16,16] subtract(clamp_2, subtract_6)
  add_3 = s8[16,16] add(clamp_2, subtract_0)
  negate_4 = s8[16,16] negate(subtract_0)
  negate_5 = s8[16,16] negate(add_3)
  negate_9 = s8[16,16] negate(negate_10)
  negate_13 = s8[16,16] negate(negate_10)
  maximum_17 = s8[16,16] maximum(negate_5, broadcast_7)
  reverse_18 = s8[16,16] reverse(negate_9), dimensions={0,1}
  clamp_lo_19 = s8[] constant(-29)
  clamp_lo_bc_19 = s8[16,16] broadcast(clamp_lo_19), dimensions={}
  clamp_hi_19 = s8[] constant(4)
  clamp_hi_bc_19 = s8[16,16] broadcast(clamp_hi_19), dimensions={}
  clamp_19 = s8[16,16] clamp(clamp_lo_bc_19, reverse_18, clamp_hi_bc_19)
  negate_14 = s8[16,16] negate(clamp_19)
  reverse_26 = s8[16,16] reverse(add_3), dimensions={0,1}
  add_27 = s8[16,16] add(maximum_17, broadcast_7)
  concat_0 = s8[16,16] add(add_1, negate_4)
  concat_1 = s8[16,16] add(concat_0, negate_13)
  concat_2 = s8[16,16] add(concat_1, negate_14)
  concat_3 = s8[16,16] add(concat_2, reverse_26)
  concat_4 = s8[16,16] add(concat_3, add_27)
  concat_4_reduced = s8[16] reduce(concat_4, reduce_init), dimensions={0}, to_apply=reduce_add
  ROOT concat_4_reshaped = s8[16,1] reshape(concat_4_reduced)
}
